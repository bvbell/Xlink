#!/bin/bash
# flexddg CLI; uses the group miniconda python (numpy, pandas, matplotlib) unless FLEXDDG_PYTHON is set.
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "${FLEXDDG_PYTHON:-/home/groups/possu/miniconda/bin/python3}" -m flexddg "$@"
