# Run data: too large for git, or regenerable. NOTE: $SCRATCH purges files untouched
# for 90 days and holds the only copy of everything listed here.
flexddg/*/output/
flexddg/*/inputs/
flexddg/*/logs/
flexddg/*/tasks/
flexddg/*/fab_complete/
flexddg/*/interim_complete/
flexddg/*/timing/
flexddg/*/relax/decoys/
flexddg/*/relax/logs/
flexddg/*/*_clean.pdb
prep/chimera_work/
motif_scaffold/runs/
motif_scaffold/runs_prod/
motif_scaffold/logs/

# Upstream clone of Kortemme-Lab/flex_ddG_tutorial; its files used here are in flexddg/flexddg/
flex_ddG_tutorial/

# Superseded by flexddg/flexddg/; still read by CLDN array job 49679178, delete once it finishes
flexddg/pipeline/

# Machine-local
.claude/
*.tmp
__pycache__/

# cyclize run data: regenerable from cyclize.json via `cyclize setup` / `submit`
cyclize/*/output/
cyclize/*/inputs/
cyclize/*/logs/
cyclize/*/tasks/

# Derived structures: regenerable by scripts/representatives.py and scripts/interface.py from the
# run data above. The CSV manifests beside them ARE tracked -- they are the distilled result and the
# only part worth reading without Rosetta.
cyclize/*/representatives/*.pdb
cyclize/*/interface/complexes/
cyclize/*/rescore/*.silent
cyclize/*/rescore/*.reb
